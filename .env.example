# VISTA (Visual Intelligence & Spoken Technical Assistant) Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / LLM Provider Configuration
# Supported providers: "gemini" | "openai" | "mock"
# Default is "gemini". Set AI_PROVIDER=mock for offline development/testing without API keys.
AI_PROVIDER=gemini

# Google Gemini API (Recommended for Multimodal VISTA)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# LLM Runtime Parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30.0

# Environment & Logging
VISTA_ENV=development
LOG_LEVEL=info
